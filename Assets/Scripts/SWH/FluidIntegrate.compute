#pragma kernel ApplyForces
#pragma kernel Integrate

RWStructuredBuffer<float4> _Positions;
RWStructuredBuffer<float4> _Velocities;
StructuredBuffer<float> _ObstacleSdf;
StructuredBuffer<float4> _PositionCorrections;

int _ParticleCount;
int _IntegrateForces;
int _ApplySeparation;
int _GridX;
int _GridY;
int _GridZ;
float _DeltaTime;
float _Gravity;
float3 _ExternalAcceleration;
float3 _GridMin;
float3 _GridMax;
float _CellSize;
float _CollisionRadius;
float _WallBounce;

int SdfIndex(int3 cell)
{
    return cell.x + _GridX * (cell.y + _GridY * cell.z);
}

float SampleObstacle(float3 position)
{
    float3 coordinate = (position - _GridMin) / _CellSize - 0.5;
    int3 baseCell = (int3) floor(coordinate);
    float3 fraction = saturate(coordinate - (float3) baseCell);
    int3 size = int3(_GridX, _GridY, _GridZ);
    float result = 0.0;

    for (int z = 0; z <= 1; z++)
        for (int y = 0; y <= 1; y++)
            for (int x = 0; x <= 1; x++)
            {
                int3 cell = clamp(baseCell + int3(x, y, z), int3(0, 0, 0), size - 1);
                float3 weightAxis = lerp(1.0 - fraction, fraction, float3(x, y, z));
                result += _ObstacleSdf[SdfIndex(cell)] * weightAxis.x * weightAxis.y * weightAxis.z;
            }

    return result;
}

// 외력 적용
[numthreads(64, 1, 1)]
void ApplyForces(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint) _ParticleCount)
    {
        return;
    }

    float4 velocity = _Velocities[i];
    velocity.xyz += (_ExternalAcceleration + float3(0.0, _Gravity, 0.0)) * _DeltaTime;
    _Velocities[i] = velocity;
}

// 위치 및 충돌
[numthreads(64, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint) _ParticleCount)
    {
        return;
    }

    float3 position = _Positions[i].xyz;
    float3 velocity = _Velocities[i].xyz;

    if (_IntegrateForces != 0)
    {
        velocity += (_ExternalAcceleration + float3(0.0, _Gravity, 0.0)) * _DeltaTime;
    }

    position += velocity * _DeltaTime;
    if (_ApplySeparation != 0)
    {
        position += _PositionCorrections[i].xyz;
    }

    float3 lower = _GridMin + _CollisionRadius;
    float3 upper = _GridMax - _CollisionRadius;

    for (int axis = 0; axis < 3; axis++)
    {
        if (position[axis] < lower[axis])
        {
            position[axis] = lower[axis];
            velocity[axis] = max(0.0, velocity[axis]) - min(0.0, velocity[axis]) * _WallBounce;
        }
        else if (position[axis] > upper[axis])
        {
            position[axis] = upper[axis];
            velocity[axis] = min(0.0, velocity[axis]) - max(0.0, velocity[axis]) * _WallBounce;
        }
    }

    for (int step = 0; step < 2; step++)
    {
        float distance = SampleObstacle(position);
        if (distance >= _CollisionRadius)
        {
            break;
        }

        float offset = _CellSize * 0.5;
        float3 gradient = float3(
            SampleObstacle(position + float3(offset, 0, 0)) - SampleObstacle(position - float3(offset, 0, 0)),
            SampleObstacle(position + float3(0, offset, 0)) - SampleObstacle(position - float3(0, offset, 0)),
            SampleObstacle(position + float3(0, 0, offset)) - SampleObstacle(position - float3(0, 0, offset)));
        float gradientLength = length(gradient);
        float3 normal = gradientLength > 0.000001 ? gradient / gradientLength : float3(0, 1, 0);
        position += normal * (_CollisionRadius - distance);

        float normalSpeed = dot(velocity, normal);
        if (normalSpeed < 0.0)
        {
            velocity -= (1.0 + _WallBounce) * normalSpeed * normal;
        }
    }

    position = clamp(position, lower, upper);
    _Positions[i] = float4(position, 1.0);
    _Velocities[i] = float4(velocity, 0.0);
}